{
  "name": "sakai-ng",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:dashboard": "ng serve dashboard",
    "dev:landing": "ng serve landing",
    "dev:auth": "ng serve auth",
    "build": "npm run build:shared-ui && npm run build:dashboard && npm run build:landing && npm run build:auth",
    "build:shared-ui": "ng build shared-ui",
    "build:dashboard": "ng build dashboard",
    "build:landing": "ng build landing",
    "build:auth": "ng build auth",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
    "test": "ng test",
    "test:all": "ng test shared-ui --watch=false && ng test auth --watch=false && ng test landing --watch=false && ng test dashboard --watch=false",
    "test:coverage": "ng test shared-ui --watch=false --coverage && ng test auth --watch=false --coverage && ng test landing --watch=false --coverage && ng test dashboard --watch=false --coverage",
    "test:mutation": "npm run test:mutation:auth && npm run test:mutation:landing && npm run test:mutation:dashboard",
    "test:mutation:auth": "stryker run stryker.auth.config.json",
    "test:mutation:landing": "cross-env NODE_OPTIONS=--max-old-space-size=4096 stryker run stryker.landing.config.json",
    "test:mutation:dashboard": "cross-env NODE_OPTIONS=--max-old-space-size=4096 stryker run stryker.dashboard.config.json",
    "test:property": "vitest run projects/auth/src/app/guards/guest.guard.spec.ts projects/dashboard/src/app/layout/layout.spec.ts projects/dashboard/src/app/pages/service/user.service.spec.ts --config vitest.dashboard.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/accessibility",
    "test:ssr": "powershell -ExecutionPolicy Bypass -File scripts/test-ssr.ps1",
    "test:perf": "lhci autorun",
    "test:security": "powershell -ExecutionPolicy Bypass -File scripts/security-scan.ps1",
    "test:load": "artillery run load-tests/landing-load.yml",
    "test:load:auth": "artillery run load-tests/auth-load.yml",
    "test:all-layers": "npm run test:all && npm run test:property && npm run test:integration && npm run test:ssr && npm run test:security",
    "serve:ssr:landing": "node dist/landing/server/server.mjs",
    "serve:ssr:auth": "node dist/auth/server/server.mjs",
    "serve:ssr:dashboard": "node dist/dashboard/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@primeuix/themes": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.11",
    "chart.js": "4.4.2",
    "express": "^5.1.0",
    "primeclt": "^0.1.5",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "artillery": "^2.0.34",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.2.1",
    "fast-check": "^4.10.0",
    "happy-dom": "^20.14.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "jsdom": "^28.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
