# Stage 1: Build application
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

COPY . .
RUN npm run build

# Stage 2: Production image with Nginx
FROM nginxinc/nginx-unprivileged:1.25-alpine AS production

COPY docker/web/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/dashboard/browser /usr/share/nginx/html
COPY --from=builder /app/dist/auth/browser /usr/share/nginx/html
COPY --from=builder /app/dist/landing/browser /usr/share/nginx/html/landing

EXPOSE 4200

CMD ["nginx", "-g", "daemon off;"]